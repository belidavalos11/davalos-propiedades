# ========================================================
# Variables de Entorno para Vercel - DÁVALOS PROPIEDADES
# Configuración: Vercel Dashboard > Project Settings > Environment Variables
# ========================================================

# 1. Notificaciones por Email (Resend)
# Crea una cuenta gratuita en https://resend.com y genera tu API Key en el panel.
RESEND_API_KEY=re_123456789_abcdefg

# Remitente de los correos automáticos (Opcional).
# Si aún no validaste tu dominio propio en Resend, puedes usar el dominio de pruebas:
# RESEND_FROM_EMAIL=Dávalos Propiedades <onboarding@resend.dev>
# Una vez validado tu dominio oficial (ej. davalospropiedades.com.ar):
RESEND_FROM_EMAIL=Dávalos Propiedades <notificaciones@davalospropiedades.com.ar>

# URL del sitio para los botones de acción en los correos (Opcional).
# Si no se define, se detecta automáticamente el host de Vercel (x-forwarded-host).
SITE_URL=https://davalospropiedades.com.ar

# Correos de respaldo para notificaciones (Opcional).
# Lista de emails separados por coma que recibirán las alertas como fallback si Firestore no está conectado en el servidor:
# NOTIFY_EMAILS=tu-email@gmail.com

# 2. Conexión Backend con Firestore (Opcional)
# ID del proyecto de Firebase (por defecto "davalos-propiedades")
FIREBASE_PROJECT_ID=davalos-propiedades

# Clave de cuenta de servicio de Firebase (JSON en una sola línea o base64).
# Permite a las funciones serverless de Vercel consultar Firestore sin depender del cliente.
# (Generar en Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"davalos-propiedades",...}

# 3. Inteligencia Artificial (Google Gemini)
# Clave gratuita de Google Gemini para redactar descripciones profesionales con IA:
# Obtén tu clave en: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy...

# Modelo de Gemini (Opcional, por defecto "gemini-2.5-flash"):
GEMINI_MODEL=gemini-2.5-flash
