rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers (sin correos fijos: todo sale de users/{uid}) ----------
    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function bootstrapPath() {
      return /databases/$(database)/documents/meta/bootstrap;
    }

    function hasProfile() {
      return exists(profilePath());
    }

    function myProfile() {
      return get(profilePath()).data;
    }

    function isActiveMember() {
      return signedInWithGoogle() && hasProfile() && myProfile().status == 'active';
    }

    function isSuperAdmin() {
      return isActiveMember() && myProfile().role == 'SUPER_ADMIN';
    }

    function isAdminOrSuperAdmin() {
      return isActiveMember() && myProfile().role in ['SUPER_ADMIN', 'ADMIN'];
    }

    function canManageProperties() {
      return isActiveMember() && myProfile().role in ['SUPER_ADMIN', 'ADMIN', 'AGENT'];
    }

    function canDeleteProperties() {
      return isAdminOrSuperAdmin();
    }

    function isPropertyOwnerOrAssigned(data) {
      return (data.agentId != null && data.agentId == request.auth.uid)
        || (data.createdBy != null && data.createdBy == request.auth.uid)
        || (data.agentEmail != null && data.agentEmail.lower() == request.auth.token.email.lower())
        || (data.creatorEmail != null && data.creatorEmail.lower() == request.auth.token.email.lower())
        || (data.agent != null && myProfile().displayName != null && data.agent == myProfile().displayName);
    }

    function canUpdateProperty(resourceData) {
      return isAdminOrSuperAdmin()
        || (isActiveMember() && myProfile().role == 'AGENT' && isPropertyOwnerOrAssigned(resourceData));
    }

    // Perfil nuevo propio, con el rol/estado indicados.
    function validNewProfile(role, status) {
      let d = request.resource.data;
      return d.keys().hasOnly(['email', 'displayName', 'photoURL', 'role', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['email', 'role', 'status', 'createdAt', 'updatedAt'])
        && d.email == request.auth.token.email.lower()
        && d.role == role
        && d.status == status
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    // Cada persona solo puede refrescar su nombre/foto; nunca su rol ni su estado.
    function onlyProfileFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['displayName', 'photoURL', 'updatedAt']);
    }

    function validRoleAndStatus() {
      return request.resource.data.role in ['AGENT', 'ADMIN', 'SUPER_ADMIN']
        && request.resource.data.status in ['pending', 'active', 'inactive'];
    }

    // ---------- Catalogo ----------
    match /properties/{docId} {
      allow read: if true;
      allow create: if canManageProperties();
      allow update: if canUpdateProperty(resource.data);
      allow delete: if canDeleteProperties();
    }

    match /deleted_properties/{docId} {
      allow read: if true;
      allow write: if canDeleteProperties();
    }

    // ---------- Usuarios y roles ----------
    match /users/{userId} {
      // Cada persona lee su propio perfil; el SUPER_ADMIN activo lee y lista todos.
      allow get: if signedInWithGoogle() && (request.auth.uid == userId || isSuperAdmin());
      allow list: if isSuperAdmin();

      // Solicitud propia (AGENT / pending) o reclamo de arranque (SUPER_ADMIN / active) si nadie lo reclamo aun.
      // El reclamo exige crear meta/bootstrap en el mismo lote (existsAfter), lo que sella el arranque.
      allow create: if signedInWithGoogle()
        && request.auth.uid == userId
        && (validNewProfile('AGENT', 'pending')
            || (validNewProfile('SUPER_ADMIN', 'active')
                && !exists(bootstrapPath())
                && existsAfter(bootstrapPath())));

      // Solo un SUPER_ADMIN activo asigna roles/estados (a otras cuentas, nunca a la propia).
      allow update: if (isSuperAdmin() && request.auth.uid != userId && validRoleAndStatus())
        || (signedInWithGoogle() && request.auth.uid == userId && onlyProfileFieldsChanged());

      allow delete: if isSuperAdmin() && request.auth.uid != userId;
    }

    // Marcador de arranque: se crea una sola vez (por el primer usuario o por un SUPER_ADMIN existente).
    match /meta/bootstrap {
      allow get: if signedInWithGoogle();
      allow create: if signedInWithGoogle()
        && getAfter(profilePath()).data.role == 'SUPER_ADMIN'
        && getAfter(profilePath()).data.status == 'active'
        && (isSuperAdmin() || !hasProfile());
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}