rules_version = '2';

// Reglas de Firebase Storage - imagenes de propiedades.
// Lectura publica; subida/borrado solo para miembros con users/{uid}.status == 'active' (Firestore).
// `bootstrapSuperAdmins` debe coincidir con firestore.rules y SITE_CONFIG.superAdminEmails.
// NOTA: usa reglas entre servicios (firestore.get); al desplegar con Firebase CLI se concede el permiso necesario.
service firebase.storage {
  match /b/{bucket}/o {

    function bootstrapSuperAdmins() {
      return ['belidavalos.bd@gmail.com'];
    }

    function signedInWithGoogle() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true;
    }

    function profilePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function isActiveMember() {
      return signedInWithGoogle()
        && (request.auth.token.email.lower() in bootstrapSuperAdmins()
            || (firestore.exists(profilePath())
                && firestore.get(profilePath()).data.status == 'active'));
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isActiveMember();
    }
  }
}